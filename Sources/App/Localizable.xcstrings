    "app.0DisablesReductionNoiseReductionPrecedesSharpeningCheckTexture": {
      "extractionState": "manual",
      "comment": "Sources/UI/DevelopPanel.swift: 277",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0 disables reduction. Noise reduction precedes sharpening. Check texture and color edges at 100%."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0 关闭；先降噪、后锐化。100% 检查纹理与彩色边缘。"
          }
        }
      }
    },
    "app.0KeepsCurrentSettings100UsesThePresetAnd": {
      "extractionState": "manual",
      "comment": "Sources/UI/WorkspaceView.swift: 1614",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0% keeps current settings, 100% uses the preset, and 200% continues equally beyond it. Point Color amounts scale between empty and sampled lists; different nonempty lists switch at 50%, while matching samples blend by identity. Values are clamped to control ranges. Integer values such as grain seeds are preserved. Preset masks are added only when the photo lacks the same mask, with their effect scaled by Amount."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0% 保持现状，100% 用预设，200% 从现状朝预设再走一倍。点颜色空列表与取样列表间缩放调整量；不同的非空取样列表在 50% 整组切换，相同取样按身份混合。超出控件范围的截断。颗粒种子这类整数不变。预设里带的蒙版只在照片还没有同样蒙版时才加入，效果按强度缩放。"
          }
        }
      }
    },
