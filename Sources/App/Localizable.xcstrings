    "app.existingStacksAreSkippedOnlyValidFullCaptureTimes": {
      "extractionState": "manual",
      "comment": "Sources/UI/StackControls.swift: 40",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing stacks are skipped. Only valid full capture times are compared, preserving fractional seconds and explicit time zones. Unknown time zones are compared within the same source root only, never mixed with known zones. File modification times are not used."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳过已有堆叠。仅比较有效完整拍摄时间，保留小数秒和显式时区；未知时区只在同一来源根内互比，不与有时区时间混比。不使用文件修改时间。"
          }
        }
      }
    },
