    "app.captureFieldsAreLimitedToCameraLensTimeISO": {
      "extractionState": "manual",
      "comment": "Sources/UI/ExportSheet.swift: 423",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture fields are limited to camera / lens, time, ISO, aperture, shutter, and focal length. Keywords and captions come from the selected version and are frozen at submission. Only corresponding XMP / IPTC fields are generated; original XMP, MakerNotes, and thumbnails are excluded. Orientation, dimensions, ICC, and bit depth reflect the output. Readback mismatches stop publication. Originals are preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄信息仅限相机／镜头、时间、ISO、光圈、快门和焦距。关键词与题注取自所选版本，按提交时的内容冻结；只生成对应的 XMP／IPTC 描述字段，不复制原片的 XMP、MakerNotes 或缩略图。方向、尺寸、ICC 与位深按成片生成。逐项回读不一致则停止发布；不写回原片。"
          }
        }
      }
    },
