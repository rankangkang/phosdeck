      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Embedded preview available for visual reference. Its camera style is not a color-accuracy target."
          }
        },
        "zh-Hans": {
          "stringUnit": {
