    },
    "camera.evidence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A successful check is evidence for these files on this macOS and RAW decoder version. It does not certify every compression mode or color accuracy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查成功只代表这些文件在本机 macOS 和 RAW 解码器版本下的结果，不代表所有压缩模式或色彩准确性均已验证。"
          }
        }
      }
    },
    "camera.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check up to 32 RAW files directly inside a folder you choose. Originals and catalog edits are preserved. No data is uploaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅检查所选文件夹内的前 32 个 RAW 文件，不递归。保留原片和图库编辑，不上传数据。"
          }
        }
      }
    },
