    "app.negativeVerticalExpandsTheTopNegativeHorizontalExpandsThe": {
      "extractionState": "manual",
      "comment": "Sources/UI/DevelopPanel.swift: 492",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Negative Vertical expands the top; negative Horizontal expands the left. Positive Aspect stretches vertically and narrows horizontally. Constrain Crop removes blank edges; otherwise transparency is retained and JPEG needs a black or white matte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "负垂直扩大上方，负水平扩大左侧；正纵横拉长纵向、缩窄横向。固定画幅，约束内框为实际输出；关闭约束保留透明边界，JPEG 需明确选择黑或白铺底。"
          }
        }
      }
    },
