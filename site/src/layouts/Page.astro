---
import '../styles/site.css';
import { copy, type Locale } from '../content';
import { themeCSS } from '../design';
import favicon from '../../../design/logo/logo-icon-graphite.svg?url';
import socialImage from '../assets/workspace-graphite.jpg';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale];
const base = import.meta.env.BASE_URL;
const canonical = new URL(`${base}${locale === 'zh' ? 'zh/' : ''}`, Astro.site);
---
<!doctype html>
<html lang={t.language} data-theme="graphite">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t.description} />
    <meta name="theme-color" content="#1C1D1C" />
    <meta name="color-scheme" content="dark light" />
    <title>{t.title}</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(base, Astro.site)} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(`${base}zh/`, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(base, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Phosdeck" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:image" content={new URL(socialImage.src, Astro.site)} />
    <meta property="og:image:width" content={String(socialImage.width)} />
    <meta property="og:image:height" content={String(socialImage.height)} />
    <meta property="og:image:alt" content={t.screenshotAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try {
        if (localStorage.getItem('phosdeck.website.theme') === 'ivory') {
          document.documentElement.dataset.theme = 'ivory';
        }
      } catch { /* Graphite remains usable when storage is unavailable. */ }
    </script>
    <style is:inline set:html={themeCSS}></style>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <div class="site-shell"><slot /></div>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
